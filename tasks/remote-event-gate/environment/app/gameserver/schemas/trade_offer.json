{
  "event": "trade_offer",
  "rate": {"max": 2, "window": 10.0},
  "fields": {
    "to": {"type": "player_ref"},
    "items": {
      "type": "list",
      "min_items": 1,
      "max_items": 8,
      "unique_by": "item_id",
      "item": {
        "type": "object",
        "fields": {
          "item_id": {"type": "id", "ref": "owned"},
          "qty": {"type": "int", "min": 1, "max": 999}
        }
      }
    },
    "coins": {"type": "int", "min": 0, "max": 1000000, "optional": true}
  }
}
